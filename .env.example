# Yash OS — Environment Configuration Template
# Copy this file to .env.local for local overrides.
# Since Yash OS operates offline-first using local browser storage,
# all variables below are OPTIONAL and disabled by default.

# -----------------------------------------------------------------------------
# Optional: Application Server & Port Configuration
# -----------------------------------------------------------------------------
# PORT: Local development server port (default: 3000)
PORT=3000

# HOST: Network host interface binding (default: 0.0.0.0)
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Optional: Future Phase Integrations (Cloud Sync & AI Analyst)
# -----------------------------------------------------------------------------
# VITE_AI_PROVIDER: Provider name for future serverless AI insights (e.g. gemini, anthropic, openai)
# VITE_AI_PROVIDER=gemini

# VITE_AI_API_KEY: Future API key for AI Analyst execution evaluation (leave blank for local mock)
# VITE_AI_API_KEY=your_api_key_here

# VITE_SYNC_ENDPOINT: Optional custom remote backup sync endpoint
# VITE_SYNC_ENDPOINT=https://api.yourdomain.com/v1/sync
